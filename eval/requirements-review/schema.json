{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relayops.local/schema/requirements-review-eval.v1.json",
  "title": "RelayOps requirements review evaluation set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": "relayops.requirements-review.eval.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "input", "tags", "expect", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^rr-[0-9]{3}-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "input": { "type": "string", "minLength": 1, "maxLength": 6000 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "notes": { "type": "string", "minLength": 1 },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectNoFindings", "requiredFindings", "forbiddenFindings", "requiredCriteria", "forbiddenTerms"],
            "properties": {
              "expectNoFindings": { "type": "boolean" },
              "requireDistinctFindings": { "type": "boolean" },
              "requiredFindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "anyOf"],
                  "properties": {
                    "kind": { "enum": ["GAP", "AMBIGUITY", "CONFLICT"] },
                    "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                    "minEvidence": { "type": "integer", "minimum": 1, "maximum": 10 }
                  }
                }
              },
              "forbiddenFindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "kind": { "enum": ["GAP", "AMBIGUITY", "CONFLICT"] },
                    "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "requiredCriteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["anyOf"],
                  "properties": {
                    "anyOf": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  }
                }
              },
              "forbiddenTerms": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
