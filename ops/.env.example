# Copy to ops/.env, replace all values locally, never commit ops/.env.
DB_PASSWORD=replace_with_a_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_root_password
RELAYOPS_DEMO_PASSWORD=replace_with_12_to_72_byte_demo_password
# Generate 32 random bytes and Base64-encode them; see README.
RELAYOPS_MASTER_KEY=replace_with_base64_key
RABBITMQ_USERNAME=relayops
RABBITMQ_PASSWORD=replace_with_a_random_broker_password
