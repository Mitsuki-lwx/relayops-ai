# Copy to ops/.env, replace all values locally, never commit ops/.env.
DB_PASSWORD=replace_with_a_random_database_password
# Optional native MySQL connection; init-native-mysql.mjs writes these locally.
# DB_URL=jdbc:mysql://127.0.0.1:3306/relayops?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# DB_USERNAME=relayops_local
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_root_password
RELAYOPS_DEMO_PASSWORD=replace_with_12_to_72_byte_demo_password
# Generate 32 random bytes and Base64-encode them; see README.
RELAYOPS_MASTER_KEY=replace_with_base64_key
RABBITMQ_USERNAME=relayops
RABBITMQ_PASSWORD=replace_with_a_random_broker_password

# Compatible mode sends documents to the configured provider and may incur fees.
RELAYOPS_MODEL_MODE=fake
RELAYOPS_MODEL_ENDPOINT=
RELAYOPS_MODEL_API_KEY=
RELAYOPS_MODEL_NAME=
RELAYOPS_MODEL_TIMEOUT_SECONDS=60
RELAYOPS_MODEL_MAX_TOKENS=4096
RELAYOPS_MODEL_TOKEN_PARAMETER=max_tokens
RELAYOPS_MODEL_JSON_MODE=true
